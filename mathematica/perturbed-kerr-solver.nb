       RowBox[{"nWin", ":", 
        RowBox[{"number", " ", "of", " ", "lambda", " ", 
         RowBox[{"windows", "."}]}]}]}]}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "islandAreas", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"islandAreas", "[", 
