                 RowBox[{"refP", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "1"}], "]"}], "]"}]}], "]"}], "<", 
               "tol"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cross", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", 
