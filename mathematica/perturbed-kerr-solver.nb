     "than", " ", "a", " ", "quarter", " ", "of", " ", "the", " ", "typical", 
     " ", "crossing", " ", "spacing", " ", "are", " ", "dropped", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"e", ".", "g", ".", "past"}], " ", "the", " ", "end", " ", 
        "of", " ", "the", " ", "reference", " ", "file"}], ")"}], ".", 
      "islandOK"}], " ", "flags", " ", "pairs", " ", "whose", " ", "island", " ",
      "labels", " ", "disagree"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
      "which", " ", "would", " ", "mean", " ", "one", " ", "run", " ", 
       "gained", " ", "or", " ", "lost", " ", "a", " ", "crossing", " ", 
       "and", " ", "the", " ", "comparison", " ", "has", " ", "shifted", " ", 
       "by", " ", 
       RowBox[{"one", ".", "Run"}], " ", "after", " ", "the", " ", "crossing",
        " ", "cell", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"needs", " ", "cross"}], ",", "refP"}], ")"}], "."}]}], 
      "\[IndentingNewLine]", "===", "===", "===", "===", "===", "===", "===", 
