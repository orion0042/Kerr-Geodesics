Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"windowReport", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lo_", ",", "hi_"}], "}"}], ",", 
      RowBox[{"step_", ":", "0.10"}]}], "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<integrated \>\"", ",", "lo", ",", "\"\<-\>\"", ",", "hi", 
        ",", "\"\<: \>\"", ",", 
        RowBox[{"InputForm", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lm", ",", 
             RowBox[{"rInt", "[", "lm", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"lm", ",", "lo", ",", "hi", ",", "step"}], "}"}]}], 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<ref  \>\"", ",", "lo", ",", "\"\<-\>\"", ",", "hi", 
        ",", "\"\<: \>\"", ",", 
        RowBox[{"InputForm", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"lm", ",", 
             RowBox[{"refRInt", "[", "lm", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"lm", ",", "lo", ",", "hi", ",", "step"}], "}"}]}], 
          "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<events: \>\"", ",", 
        RowBox[{"InputForm", "@", 
         RowBox[{"Select", "[", 
          RowBox[{"evlog", ",", 
           RowBox[{
            RowBox[{"lo", "<", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", "hi"}], "&"}]}], "]"}]}]}],
        "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<V1 min: \>\"", ",", 
        RowBox[{"InputForm", "@", 
         RowBox[{"Min", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"V1f", "[", 
             RowBox[{
              RowBox[{"rInt", "[", "lm", "]"}], ",", 
              RowBox[{"thInt", "[", "lm", "]"}], ",", 
              RowBox[{"Kfun", "[", "lm", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"lm", ",", "lo", ",", "hi", ",", "0.005"}], "}"}]}], 
           "]"}], "]"}]}]}], "]"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
