Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gridD", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"Min", "[", 
      RowBox[{"1000", ",", "lamCmp"}], "]"}], ",", "0.002"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dR", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lm", ",", 
       RowBox[{
        RowBox[{"rInt", "[", "lm", "]"}], "-", 
        RowBox[{"refRInt", "[", "lm", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lm", ",", "gridD"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dT", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lm", ",", 
        RowBox[{
         RowBox[{"thInt", "[", "lm", "]"}], "-", 
         RowBox[{"refThInt", "[", "lm", "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"lm", ",", "gridD"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<first lam with |dr| > 0.1 : \>\"", ",", 
    RowBox[{"InputForm", "@", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"dR", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "0.1"}], "&"}]}], 
      "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<first lam with |dr| > 1.0 : \>\"", ",", 
    RowBox[{"InputForm", "@", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{"dR", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "1.0"}], "&"}]}], 
      "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<largest 10 |dr|:  \>\"", ",", 
    RowBox[{"InputForm", "@", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"SortBy", "[", 
        RowBox[{"dR", ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}], ",", 
       "10"}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<largest 10 |dth|: \>\"", ",", 
     RowBox[{"InputForm", "@", 
      RowBox[{"Take", "[", 
       RowBox[{
        RowBox[{"SortBy", "[", 
         RowBox[{"dT", ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Abs", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}], ",", 
        "10"}], "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
