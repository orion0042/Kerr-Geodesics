Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", "enclosed"}]}], " ", "phase"}], "-", 
    RowBox[{
    "space", " ", "area", " ", "of", " ", "a", " ", "set", " ", "of", " ", 
     "section", " ", 
     RowBox[{
      RowBox[{"points", "--"}], "--"}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Sorting", " ", "by", " ", "angle", " ", "about", " ", "the", " ", 
    "centroid", " ", "is", " ", "what", " ", "makes", " ", "the", " ", 
    "polygon", " ", "the", " ", "island", " ", "boundary", " ", "rather", " ",
     "than", " ", "the", " ", "order", " ", "the", " ", "orbit", " ", 
    "visited", " ", "the", " ", 
    RowBox[{"points", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "enclosedArea", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"enclosedArea", "[", "pts_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", "ord", ",", "p"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "pts", "]"}], "<", "4"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<too few points\>\"", "]"}], "]"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"c", "=", 
         RowBox[{"Mean", "[", "pts", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ord", "=", 
         RowBox[{"SortBy", "[", 
          RowBox[{"pts", ",", 
           RowBox[{
            RowBox[{"ArcTan", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "-", 
               RowBox[{"c", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "&"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"ord", ",", 
           RowBox[{"First", "[", "ord", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Abs", "@", 
          RowBox[{"Total", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "1"}], "]"}], "]"}], " ", 
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}]}], "-", 
              RowBox[{
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], " ", 
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "2"}], "]"}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{
                RowBox[{"Length", "[", "p", "]"}], "-", "1"}]}], "}"}]}], 
            "]"}], "]"}]}], "/", "2"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", "area"}]}], " ", "per", " ", "island"}], ",", 
