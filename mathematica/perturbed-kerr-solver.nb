               RowBox[{"[", "plIdx", "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<longest starts at lam \>\"", ",", 
         RowBox[{"trajC", "[", 
          RowBox[{"[", 
