       RowBox[{"Scaled", "[", "0.05", "]"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"ImageSize", "->", "600"}], ",", 
