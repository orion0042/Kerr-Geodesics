Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "evR", ",", "ourT", ",", "cmp", ",", "ap", ",", "pe", ",", "nearest", ",",
      "turns"}], "}"}], ",", 
   RowBox[{
    RowBox[{"turns", "=", "refTurns"}], ";", "\[IndentingNewLine]", 
    RowBox[{"evR", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"evlog", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "===", "\"\<r\>\""}], "&"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ourT", "=", 
     RowBox[{"evR", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nearest", "[", "lm_", "]"}], ":=", 
     RowBox[{"First", "@", 
      RowBox[{"SortBy", "[", 
       RowBox[{"turns", ",", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", "lm"}], "]"}], "&"}]}], 
       "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"cmp", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ref", "=", 
           RowBox[{"nearest", "[", 
            RowBox[{"ourT", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ourT", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"ourT", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"ourT", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "-", 
            RowBox[{"ref", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "ourT", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"cmp", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"cmp", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}], "<", "0.01"}], "&"}]}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ap", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"cmp", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ">", "20"}], "&"}]}], "]"}]}], ";", 
    
    RowBox[{"pe", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"cmp", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "<=", "20"}], "&"}]}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<aphelion slope:   \>\"", ",", 
      RowBox[{"InputForm", "@", 
       RowBox[{
        RowBox[{
         RowBox[{"LinearModelFit", "[", 
          RowBox[{
           RowBox[{"ap", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", "lmF", ",",
            "lmF"}], "]"}], "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", "\"\<  (was 8.4e-7)\>\""}], 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<perihelion slope: \>\"", ",", 
      RowBox[{"InputForm", "@", 
       RowBox[{
        RowBox[{
         RowBox[{"LinearModelFit", "[", 
          RowBox[{
           RowBox[{"pe", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}], ",", "lmF", ",",
            "lmF"}], "]"}], "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", "\"\<  (was 1.1e-10)\>\""}], 
     "]"}]}]}], "]"}]], "Input",
