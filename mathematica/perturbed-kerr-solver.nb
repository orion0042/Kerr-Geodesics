36aa40191190"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"plDr", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Differences", "[", "rA", "]"}], "]"}]}], ";", 
  RowBox[{"plMed", "=", 
   RowBox[{"Median", "[", "plDr", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plFlags", "=", 
   RowBox[{"UnitStep", "[", 
    RowBox[{
     RowBox[{"0.05", " ", "plMed"}], "-", "plDr"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plSplit", "=", 
   RowBox[{"Split", "[", "plFlags", "]"}]}], ";", 
  RowBox[{"plLens", "=", 
   RowBox[{"Length", "/@", "plSplit"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plEnds", "=", 
   RowBox[{"Accumulate", "[", "plLens", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plIdx", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "plSplit", "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "1"}], ")"}], "&"}], "/@", 
       "plSplit"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<median |dr|: \>\"", ",", "plMed", 
    ",", "\"\<   plateau count: \>\"", ",", 
    RowBox[{"Length", "[", "plIdx", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"plIdx", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"Print", "[", "\"\<none above threshold\>\"", "]"}], ",", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<10 longest (lam): \>\"", ",", 
       RowBox[{
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"Reverse", "@", 
           RowBox[{"Sort", "[", 
            RowBox[{"plLens", "[", 
             RowBox[{"[", "plIdx", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"UpTo", "[", "10", "]"}]}], "]"}], " ", "dLam"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", "=", 
         RowBox[{"plIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
              RowBox[{"plLens", "[", 
               RowBox[{"[", "plIdx", "]"}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<longest starts at lam \>\"", ",", 
         RowBox[{"trajC", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"plEnds", "[", 
              RowBox[{"[", "b", "]"}], "]"}], "-", 
             RowBox[{"plLens", "[", 
              RowBox[{"[", "b", "]"}], "]"}], "+", "1"}], ",", "1"}], "]"}], 
          "]"}], ",", "\"\<   width \>\"", ",", 
         RowBox[{
          RowBox[{"plLens", "[", 
           RowBox[{"[", "b", "]"}], "]"}], " ", "dLam"}]}], "]"}]}], 
      "]"}]}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.996579319033038*^9, 3.996579319033053*^9}, {
