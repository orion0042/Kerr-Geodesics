     RowBox[{
      RowBox[{
       RowBox[{
       "POINCARE", " ", "CROSSING", " ", "ERRORS", " ", "BY", " ", "ISLAND", " ",
         "Pairs", " ", "each", " ", "crossing", " ", "in", " ", "cross", " ", 
        "with", " ", "the", " ", "nearest"}], "-", "in", "-", 
