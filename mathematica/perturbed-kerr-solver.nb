    RowBox[{"grid", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", "990.", ",", "0.01"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"prs", "=", 
     RowBox[{"pf", "/@", "grid"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"zeros", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Most", "[", 
