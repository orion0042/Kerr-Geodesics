      "k"}], "=", 
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"k", "-", "1"}], ",", "3"}], "]"}], "+", "1"}]}], ",", 
    RowBox[{"the", " ", "same", " ", "convention", " ", "as", " ", 
