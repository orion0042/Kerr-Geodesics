         RowBox[{"loR", "+", "stepT"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"lmT", "=", 
         RowBox[{"loR", "+", 
          RowBox[{"2", " ", "stepT"}]}]}], ",", 
        RowBox[{"lmT", "<=", 
         RowBox[{"hiR", "-", "stepT"}]}], ",", 
        RowBox[{"lmT", "+=", "stepT"}], ",", 
        RowBox[{
         RowBox[{"sT", "=", 
          RowBox[{"Sign", "[", 
           RowBox[{"rdotRef", "[", "lmT", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sT", "=!=", "prevS"}], "&&", 
            RowBox[{"sT", "=!=", "0"}]}], ",", 
           RowBox[{
            RowBox[{"rootT", "=", 
             RowBox[{"xT", "/.", " ", 
              RowBox[{"FindRoot", "[", 
               RowBox[{
                RowBox[{"rdotRef", "[", "xT", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"xT", ",", 
                  RowBox[{"lmT", "-", "stepT"}], ",", "lmT"}], "}"}]}], 
               "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"out", ",", 
              RowBox[{"{", 
               RowBox[{"rootT", ",", 
                RowBox[{"refRInt", "[", "rootT", "]"}]}], "}"}]}], "]"}]}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"prevS", "=", "sT"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "out"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<refTurns: \>\"", ",", 
   RowBox[{"Length", "[", "refTurns", "]"}], ",", "\"\<   aphelion: \>\"", ",", 
   RowBox[{"Length", "[", 
