      RowBox[{
       RowBox[{"dV1dr", "[", 
        RowBox[{
         RowBox[{"rf", "[", "lm", "]"}], ",", 
         RowBox[{"tf", "[", "lm", "]"}], ",", 
         RowBox[{"Kfun", "[", "lm", "]"}]}], "]"}], " ", 
       RowBox[{"pf", "[", "lm", "]"}]}], "+", 
