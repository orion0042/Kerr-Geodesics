 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tsPan", "[", 
     RowBox[{"o_", ",", "c_", ",", "ylbl_"}], "]"}], ":=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ts", "[", 
         RowBox[{"refP", ",", "o", ",", "c"}], "]"}], ",", 
        RowBox[{"ts", "[", 
         RowBox[{"cross", ",", "o", ",", "c"}], "]"}]}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"reference", " ", "first"}], "=", "underneath"}], "*)"}], 
      RowBox[{"PlotStyle", "->", 
