Cell[BoxData[{
 RowBox[{
  RowBox[{"plDr", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Differences", "[", "rA", "]"}], "]"}]}], ";", 
  RowBox[{"plMed", "=", 
   RowBox[{"Median", "[", "plDr", "]"}]}], ";"}], "\n", 
 RowBox[{
