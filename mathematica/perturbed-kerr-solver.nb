                  RowBox[{"-", "18"}]}]}], ",", 
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"k", "-", "j"}], ",", "3"}], "]"}], "==", "0"}]}], 
               "}"}], ",", "Nothing"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "cross", "]"}]}], "}"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
