        RowBox[{
         RowBox[{"{", 
          RowBox[{"refMark", ",", "0.035"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"runMark", ",", "0.018"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
