Cell[BoxData[{
 RowBox[{
  RowBox[{"plDr", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Differences", "[", "rA", "]"}], "]"}]}], ";", 
  RowBox[{"plMed", "=", 
   RowBox[{"Median", "[", "plDr", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plFlags", "=", 
   RowBox[{"UnitStep", "[", 
    RowBox[{
     RowBox[{"0.05", " ", "plMed"}], "-", "plDr"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plSplit", "=", 
   RowBox[{"Split", "[", "plFlags", "]"}]}], ";", 
  RowBox[{"plLens", "=", 
   RowBox[{"Length", "/@", "plSplit"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plEnds", "=", 
   RowBox[{"Accumulate", "[", "plLens", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"plIdx", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
