          RowBox[{"Reverse", "@", 
           RowBox[{"Sort", "[", 
            RowBox[{"plLens", "[", 
             RowBox[{"[", "plIdx", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"UpTo", "[", "10", "]"}]}], "]"}], " ", "dLam"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"b", "=", 
         RowBox[{"plIdx", "[", 
          RowBox[{"[", 
           RowBox[{"First", "@", 
            RowBox[{"Ordering", "[", 
             RowBox[{
