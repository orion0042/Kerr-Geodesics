        "plots"}]}], "|", "dr", "|", "and", "|", "dpr", "|", 
      RowBox[{"per", " ", "crossing"}]}]}], ",", 
    RowBox[{
     RowBox[{"one", " ", "colour", " ", "per", " ", 
