      RowBox[{"[", 
       RowBox[{"All", ",", "7"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vrA", "=", 
     RowBox[{"srA", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Clip", "[", 
        RowBox[{"u1A", ",", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vthA", "=", 
