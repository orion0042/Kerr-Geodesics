            RowBox[{
             RowBox[{"plEnds", "[", 
              RowBox[{"[", "b", "]"}], "]"}], "-", 
             RowBox[{"plLens", "[", 
              RowBox[{"[", "b", "]"}], "]"}], "+", "1"}], ",", "1"}], "]"}], 
          "]"}], ",", "\"\<   width \>\"", ",", 
