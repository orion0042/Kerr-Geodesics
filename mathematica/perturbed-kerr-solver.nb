      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "==", "1"}], ")"}], "&"}], "/@", 
       "plSplit"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<median |dr|: \>\"", ",", "plMed", 
    ",", "\"\<   plateau count: \>\"", ",", 
    RowBox[{"Length", "[", "plIdx", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"plIdx", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{"Print", "[", "\"\<none above threshold\>\"", "]"}], ",", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<10 longest (lam): \>\"", ",", 
